<view class="page"><view class="language-bar"><text class="mini-brand">YOUR SHOP STARTS HERE</text><picker mode="selector" range="{{languages}}" value="{{languageIndex}}" bindchange="switchLanguage"><view class="language-picker">{{languages[languageIndex]}} ▾</view></picker></view><view class="title">{{copy.text14}}</view><view class="subtitle">{{copy.text15}}</view><view class="error" wx:if="{{displayError}}">{{displayError}}</view><button bindtap="refresh">{{copy.text16}}</button><view class="card" wx:for="{{orders}}" wx:key="id"><view class="row"><text>#{{item.number}} · {{item.store_name}}</text><text>{{item.displayStatus}}</text></view><view class="line" wx:for="{{item.items}}" wx:for-item="dish" wx:key="name">{{dish.displayName}} × {{dish.qty}}</view><view class="line">{{copy.notes}}{{item.note||copy.none}}</view><view class="price">¥{{item.displayTotal}}</view><button class="primary" wx:if="{{item.payment==='unpaid'}}" data-id="{{item.id}}" bindtap="pay">{{copy.text17}}</button><view wx:else>{{copy.text18}}</view></view><view class="card" wx:if="{{!orders.length}}">{{copy.text19}}</view></view>
