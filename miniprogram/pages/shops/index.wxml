<view class="page"><view class="language-bar"><text class="mini-brand">YOUR SHOP STARTS HERE</text><picker mode="selector" range="{{languages}}" value="{{languageIndex}}" bindchange="switchLanguage"><view class="language-picker">{{languages[languageIndex]}} ▾</view></picker></view><view class="title">{{copy.text0}}</view><view class="subtitle">{{copy.text1}}</view><view class="error" wx:if="{{displayError}}">{{displayError}}</view><view class="card" wx:for="{{stores}}" wx:key="id"><view class="row"><view class="dish-name">{{item.displayName}}</view><button class="primary" data-id="{{item.id}}" bindtap="open">{{copy.text2}}</button></view></view><view class="small" wx:if="{{!stores.length}}">{{copy.text3}}</view><button bindtap="orders">{{copy.text4}}</button></view>
