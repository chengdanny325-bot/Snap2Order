<view class="page"><view class="language-bar"><text class="mini-brand">YOUR SHOP STARTS HERE</text><picker mode="selector" range="{{languages}}" value="{{languageIndex}}" bindchange="switchLanguage"><view class="language-picker">{{languages[languageIndex]}} ▾</view></picker></view><view class="title">{{store.name}}</view><view class="subtitle">{{copy.text5}}</view><view class="error" wx:if="{{displayError}}">{{displayError}}</view><block wx:if="{{!order}}"><view class="card" wx:for="{{items}}" wx:key="id"><view class="row"><image wx:if="{{item.imageURL}}" class="dish-photo" src="{{item.imageURL}}" mode="aspectFill"/><view class="dish-info"><view class="small">{{item.displayCategory}}{{item.displayImageLabel ? " · " + item.displayImageLabel : ""}}</view><view class="dish-name">{{item.displayName}}</view><view class="price">¥{{item.displayPrice}}</view></view><view class="qty"><button data-id="{{item.id}}" data-delta="-1" bindtap="change" disabled="{{item.qty===0}}">−</button><text>{{item.qty}}</text><button data-id="{{item.id}}" data-delta="1" bindtap="change">＋</button></view></view></view><view class="card"><view>{{copy.text6}}</view><textarea placeholder="{{copy.noteExample}}" value="{{note}}" maxlength="300" bindinput="note"/><view class="row"><text>{{copy.text7}}</text><text class="price">¥{{total}}</text></view><button class="primary actions" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">{{copy.text8}}</button><view class="small">{{copy.text9}}</view></view></block><view class="card" wx:else><view>{{displayOrderStatus}}</view><view class="title">#{{order.number}}</view><view class="row line" wx:for="{{order.items}}" wx:key="name"><text>{{item.displayName}} × {{item.qty}}</text><text>¥{{item.price}}</text></view><view class="line">{{copy.notes}}{{order.note||copy.none}}</view><view class="price">¥{{order.displayTotal}}</view><view class="notice">{{copy.text10}}</view><button class="primary" wx:if="{{order.payment==='unpaid'}}" bindtap="pay" loading="{{busy}}" disabled="{{busy}}">{{copy.text11}}</button><view wx:else>✓ {{copy.text12}}</view></view><button bindtap="orders">{{copy.text13}}</button></view>
