<view class="page"><view class="title">{{store.name}}</view><view class="subtitle">扫码点单，无需注册。现点现做，好好吃饭。</view><view class="error" wx:if="{{error}}">{{error}}</view><block wx:if="{{!order}}"><view class="card" wx:for="{{items}}" wx:key="id"><view class="row"><image wx:if="{{item.imageURL}}" class="dish-photo" src="{{item.imageURL}}" mode="aspectFill"/><view class="dish-info"><view class="small">{{item.category}}{{item.imageLabel ? " · " + item.imageLabel : ""}}</view><view class="dish-name">{{item.name}}</view><view class="price">¥{{item.displayPrice}}</view></view><view class="qty"><button data-id="{{item.id}}" data-delta="-1" bindtap="change" disabled="{{item.qty===0}}">−</button><text>{{item.qty}}</text><button data-id="{{item.id}}" data-delta="1" bindtap="change">＋</button></view></view></view><view class="card"><view>口味备注</view><textarea placeholder="少辣，不要葱" value="{{note}}" maxlength="300" bindinput="note"/><view class="row"><text>合计</text><text class="price">¥{{total}}</text></view><button class="primary actions" bindtap="submit" loading="{{busy}}" disabled="{{busy}}">提交订单</button><view class="small">当前仅为模拟支付，不产生真实扣款。</view></view></block><view class="card" wx:else><view>{{orderStatus}}</view><view class="title">#{{order.number}}</view><view class="row line" wx:for="{{order.items}}" wx:key="name"><text>{{item.name}} × {{item.qty}}</text><text>¥{{item.price}}</text></view><view class="line">备注：{{order.note||'无'}}</view><view class="price">¥{{order.displayTotal}}</view><view class="notice">演示支付，不会真实扣款。</view><button class="primary" wx:if="{{order.payment==='unpaid'}}" bindtap="pay" loading="{{busy}}" disabled="{{busy}}">模拟支付</button><view wx:else>✓ 已支付（Demo）</view></view><button bindtap="orders">查看我的订单</button></view>
