# Copy to .env. Real keys belong only on the server.
OCR_PROVIDER=ocrspace
OCR_API_KEY=
OCR_PROVIDER_LABEL=OCR.space
OCR_API_URL=https://api.ocr.space/parse/image
OCR_LANGUAGE=auto
OCR_ENGINE=2
# Conservative raw-image limit for the free OCR.space plan (1MB).
OCR_MAX_IMAGE_BYTES=950000
# Optional older vision adapter: OCR_PROVIDER=vision, set its own URL and key.
OCR_MODEL=qwen3-vl-plus
HOST=0.0.0.0
PORT=8765
# Set to your actual HTTPS origin when deployed (no trailing slash).
PUBLIC_URL=
# Set 1 with HTTPS; keep 0 only for local HTTP testing.
COOKIE_SECURE=0
# DATABASE_PATH=/data/snap2order.sqlite3

# Optional native WeChat Mini Program integration (server-only secrets)
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CODE_ENV=release

# Optional AI storefront generation (OpenAI-compatible chat completions).
# Without a key the UI clearly labels its output as rule-based recommendations.
STORE_AI_API_KEY=
STORE_AI_API_URL=https://api.openai.com/v1/chat/completions
STORE_AI_MODEL=gpt-4o-mini

# Optional logo image generation; HTTPS image-generations endpoint returning data[0].b64_json.
# Also used by the OC mascot feature (AI-generated store mascot).
AI_LOGO_API_KEY=
AI_LOGO_API_URL=
AI_LOGO_MODEL=
