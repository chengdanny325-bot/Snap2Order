page{background:#f3f4ed;color:#213a2d;font-size:32rpx}.page{padding:32rpx 32rpx 120rpx}.title{font-size:46rpx;font-weight:bold;margin:24rpx 0}.subtitle{color:#647168;font-size:28rpx;line-height:1.6;margin-bottom:30rpx}.card{background:#fffefa;border:1rpx solid #d9e0d6;border-radius:20rpx;padding:28rpx;margin-bottom:20rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.primary{background:#235c43;color:white}.primary::after{border:0}button{font-size:30rpx;border-radius:12rpx}.price{color:#235c43;font-size:36rpx;font-weight:bold}.small{font-size:24rpx;color:#647168}.notice{background:#fcf0dc;padding:24rpx;border-radius:12rpx;margin:20rpx 0;font-size:28rpx;color:#76471d}.dish-name{font-size:34rpx;font-weight:bold;max-width:400rpx;word-break:break-all}.qty{display:flex;align-items:center;gap:22rpx}.qty button{width:72rpx;height:72rpx;line-height:72rpx;padding:0;margin:0}.line{padding:20rpx 0;border-bottom:1rpx solid #d9e0d6}.actions{margin-top:24rpx}.actions button{margin-bottom:16rpx}textarea{box-sizing:border-box;width:100%;border:1rpx solid #b9c5b7;border-radius:12rpx;padding:20rpx;min-height:150rpx;margin:20rpx 0;font-size:32rpx}.error{color:#973c24;margin:20rpx 0}

.dish-photo{width:144rpx;height:144rpx;flex-shrink:0;border-radius:12rpx;margin-right:16rpx}.dish-info{flex:1;min-width:0}
